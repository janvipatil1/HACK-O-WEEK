<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Browser History Simulation</title>
<style>
  body { font-family: Arial, sans-serif; margin: 20px; background: #f0f4f8; }
  h1 { color: #1e3a8a; text-align: center; }
  .container { max-width: 600px; margin: auto; background: #fff; padding: 20px; border-radius: 8px; box-shadow: 0 0 10px rgba(0,0,0,0.1); }
  input { padding: 8px; width: 70%; margin-right: 5px; border-radius: 4px; border: 1px solid #ccc; }
  button { padding: 8px 12px; border-radius: 4px; border: none; background: #1e3a8a; color: #fff; cursor: pointer; }
  button:hover { background: #374eb8; }
  ul { padding-left: 20px; margin-top: 10px; }
  li { margin-bottom: 5px; }
  .message { font-weight: bold; color: #d97706; margin-top: 10px; }
</style>
</head>
<body>

<h1>Browser History Simulator</h1>
<div class="container">
  <input type="text" id="urlInput" placeholder="Enter URL to visit">
  <button onclick="visit()">Visit</button>
  <button onclick="goBack()">Back</button>
  <button onclick="goForward()">Forward</button>
  <button onclick="currentPage()">Current Page</button>

  <div class="message" id="message"></div>

  <h3>Back Stack:</h3>
  <ul id="backStackList"></ul>

  <h3>Forward Stack:</h3>
  <ul id="forwardStackList"></ul>
</div>

<script>
  let backStack = [];
  let forwardStack = [];

  function updateDisplay() {
    const backList = document.getElementById('backStackList');
    const forwardList = document.getElementById('forwardStackList');
    backList.innerHTML = "";
    forwardList.innerHTML = "";

    backStack.slice().reverse().forEach(url => {
      const li = document.createElement('li');
      li.textContent = url;
      backList.appendChild(li);
    });

    forwardStack.slice().reverse().forEach(url => {
      const li = document.createElement('li');
      li.textContent = url;
      forwardList.appendChild(li);
    });
  }

  function visit() {
    const url = document.getElementById('urlInput').value.trim();
    const message = document.getElementById('message');
    if (!url) { message.textContent = "Enter a valid URL."; return; }
    if (backStack.length > 0) {
      forwardStack = []; // clear forward history on new visit
    }
    backStack.push(url);
    message.textContent = `Visited: ${url}`;
    updateDisplay();
  }

  function goBack() {
    const message = document.getElementById('message');
    if (backStack.length <= 1) {
      message.textContent = "No pages to go back.";
      return;
    }
    const current = backStack.pop();
    forwardStack.push(current);
    message.textContent = `Went back to: ${backStack[backStack.length - 1]}`;
    updateDisplay();
  }

  function goForward() {
    const message = document.getElementById('message');
    if (forwardStack.length === 0) {
      message.textContent = "No pages to go forward.";
      return;
    }
    const next = forwardStack.pop();
    backStack.push(next);
    message.textContent = `Went forward to: ${next}`;
    updateDisplay();
  }

  function currentPage() {
    const message = document.getElementById('message');
    if (backStack.length === 0) {
      message.textContent = "No page visited yet.";
    } else {
      message.textContent = `Current Page: ${backStack[backStack.length - 1]}`;
    }
  }

</script>

</body>
</html>
