<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Library Book Catalog</title>
<style>
  body { font-family: Arial, sans-serif; margin: 20px; background-color: #f0f4f8; }
  h1 { color: #1e3a8a; text-align: center; }
  .container { max-width: 600px; margin: auto; background: #fff; padding: 20px; border-radius: 8px; box-shadow: 0 0 10px rgba(0,0,0,0.1); }
  input[type="text"] { width: 70%; padding: 8px; margin-right: 5px; border-radius: 4px; border: 1px solid #ccc; }
  button { padding: 8px 12px; border: none; border-radius: 4px; background-color: #1e3a8a; color: #fff; cursor: pointer; }
  button:hover { background-color: #374eb8; }
  ul { margin-top: 10px; padding-left: 20px; }
  li { margin-bottom: 5px; }
  .message { margin-top: 10px; font-weight: bold; color: #d97706; }
</style>
</head>
<body>

<h1>Library Book Catalog</h1>
<div class="container">
  <input type="text" id="bookInput" placeholder="Enter book title">
  <button onclick="addBook()">Add Book</button>
  <button onclick="removeBook()">Remove Book</button>
  <button onclick="searchBook()">Search Book</button>
  <button onclick="displayBooks()">Display All</button>

  <div class="message" id="message"></div>

  <ul id="bookList"></ul>
</div>

<script>
  const MAX_BOOKS = 5;
  let library = [];

  function addBook() {
    const title = document.getElementById('bookInput').value.trim();
    const message = document.getElementById('message');
    if (!title) { message.textContent = "Please enter a book title."; return; }
    if (library.length >= MAX_BOOKS) { message.textContent = "Library is full!"; return; }
    library.push(title);
    message.textContent = `Book '${title}' added.`;
    displayBooks();
  }

  function removeBook() {
    const title = document.getElementById('bookInput').value.trim();
    const message = document.getElementById('message');
    const index = library.indexOf(title);
    if (index === -1) { message.textContent = `Book '${title}' not found.`; return; }
    library.splice(index, 1);
    message.textContent = `Book '${title}' removed.`;
    displayBooks();
  }

  function searchBook() {
    const title = document.getElementById('bookInput').value.trim();
    const message = document.getElementById('message');
    if (library.includes(title)) {
      message.textContent = `Book '${title}' is available.`;
    } else {
      message.textContent = `Book '${title}' not found.`;
    }
  }

  function displayBooks() {
    const list = document.getElementById('bookList');
    list.innerHTML = "";
    if (library.length === 0) {
      list.innerHTML = "<li>Library is empty.</li>";
    } else {
      library.forEach((book, i) => {
        const li = document.createElement('li');
        li.textContent = `${i+1}. ${book}`;
        list.appendChild(li);
      });
    }
  }
</script>

</body>
</html>
